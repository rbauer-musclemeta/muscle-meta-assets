# NotebookLM configuration for MuscleMeta
# Copy to .env.notebooklm and populate IDs by running:
#   python scripts/setup_notebooklm.py
#
# Add .env.notebooklm to .gitignore — it contains real notebook IDs.

NOTEBOOKLM_PROFILE=muscle-meta

# ── GMMBB Pillar Notebook IDs ────────────────────────────────────────────────
# Auto-populated by scripts/setup_notebooklm.py
NOTEBOOKLM_NB_GUT=
NOTEBOOKLM_NB_MUSCLE=
NOTEBOOKLM_NB_METABOLISM=
NOTEBOOKLM_NB_BONE=
NOTEBOOKLM_NB_BRAIN=
NOTEBOOKLM_NB_CONNECTIONS=

# ── CI/CD Auth ────────────────────────────────────────────────────────────────
# In GitHub Actions / Netlify, set this secret to the full contents of:
#   ~/.notebooklm/profiles/muscle-meta/storage_state.json
# Do NOT commit the actual value — use repository/environment secrets.
# NOTEBOOKLM_AUTH_JSON=

# ── Optional overrides ────────────────────────────────────────────────────────
# Override the default ~/.notebooklm home directory
# NOTEBOOKLM_HOME=~/.notebooklm
